[configuration]
entry_symbol = "handheld_ar_library_init"
compatibility_minimum = "4.7"
android_aar_plugin = true

[libraries]
macos.editor.arm64 = "res://addons/handheld_ar/bin/macos/template_debug/arm64/libhandheld_ar.dylib"
macos.debug.arm64 = "res://addons/handheld_ar/bin/macos/template_debug/arm64/libhandheld_ar.dylib"
macos.release.arm64 = "res://addons/handheld_ar/bin/macos/template_release/arm64/libhandheld_ar.dylib"
macos.editor.x86_64 = "res://addons/handheld_ar/bin/macos/template_debug/x86_64/libhandheld_ar.dylib"
macos.debug.x86_64 = "res://addons/handheld_ar/bin/macos/template_debug/x86_64/libhandheld_ar.dylib"
macos.release.x86_64 = "res://addons/handheld_ar/bin/macos/template_release/x86_64/libhandheld_ar.dylib"
ios.debug.arm64 = "res://addons/handheld_ar/bin/ios/template_debug/handheld_ar.xcframework"
ios.release.arm64 = "res://addons/handheld_ar/bin/ios/template_release/handheld_ar.xcframework"
android.debug.arm64 = "res://addons/handheld_ar/bin/android/template_debug/arm64/libhandheld_ar.so"
android.release.arm64 = "res://addons/handheld_ar/bin/android/template_release/arm64/libhandheld_ar.so"
